#!/bin/bash
# ─────────────────────────────────────────────────────────────────
# kokuho-core pre-commit hook
#
# このファイルが**唯一の正本**。git は core.hooksPath でこのディレクトリを直接使う
# （.git/hooks/ へのコピーはしない。コピーは正本とずれて古いまま残るため）。
# clone ごとに1回: bash scripts/install-hooks.sh（設定と動作確認まで行う）
#
# 内容:
#   (0) 署名（author / committer のメールが許可リストか）
#   (1) credential / SUNNET / 個人 identity の混入禁止
#   (2) slug 衝突拒否（POLICIES §9）
#   (3) cityCode 一次資料準拠
#   (4) 数値表記の保全
#   (5) 内部文書ガード（ガード本体の場所は VCS 外の git 設定 civic.guard から読む）
# ─────────────────────────────────────────────────────────────────
set -e

# ─── (0) 署名（author / committer が許可リストか） ─────────────────
# 許可リストは同じディレクトリの allowed-identities.ere だけに書く（CI の署名監査も同じファイルを読む）。
# git var は環境変数（GIT_AUTHOR_EMAIL 等）と git config の両方を反映した、このコミットで実際に使われる値を返す。
ALLOW_FILE="$(dirname "$0")/allowed-identities.ere"
if [ ! -f "$ALLOW_FILE" ]; then
  echo "❌ pre-commit: 署名の許可リストが見つかりません（$ALLOW_FILE）。fail-closed"; exit 1
fi
ALLOW="$(grep -vE '^[[:space:]]*(#|$)' "$ALLOW_FILE" | paste -sd'|' -)"
for WHO in AUTHOR COMMITTER; do
  EMAIL="$(git var "GIT_${WHO}_IDENT" 2>/dev/null | sed -E 's/.*<([^>]*)>.*/\1/' || true)"
  if [ -z "$EMAIL" ] || ! printf '%s\n' "$EMAIL" | grep -qiE "$ALLOW"; then
    echo "❌ pre-commit: ${WHO} のメール「${EMAIL}」が許可リスト外です（scripts/git-hooks/allowed-identities.ere）"
    echo "   このリポでは git config user.email を許可リストのアドレスにしてください"
    exit 1
  fi
done

# ─── (1) credential / SUNNET / 個人 identity の混入禁止 ──────────
# ⚠️ 公開リポにつき、具体識別子(個人メール/ユーザー名/内部ホスト等)は**この tracked ファイルに書かない**。
#    正本 GOVERNANCE.md §C-4。具体値は VCS外 denylist(.git/hooks/denylist.txt)から読む。
#    検知ルールを定義するインフラ(フック自身・CI)と、機密ファイル名を並べるのが役目の .gitignore は
#    走査対象から除外し自己誤爆を防ぐ（CI の秘密混入検査も同じ除外）。
#    パターンは同じディレクトリの secret-patterns.ere だけに書く（CI も同じファイルを読む）。
SCAN=(-- . ':(exclude)scripts/git-hooks' ':(exclude).github' ':(exclude).gitignore')
PAT_FILE="$(dirname "$0")/secret-patterns.ere"
if [ ! -f "$PAT_FILE" ]; then
  echo "❌ pre-commit: 秘密パターンのファイルが見つかりません（$PAT_FILE）。fail-closed"; exit 1
fi
GEN="$(grep -vE '^[[:space:]]*(#|$)' "$PAT_FILE" | paste -sd'|' -)"
if git diff --cached --unified=0 "${SCAN[@]}" | grep -E '^\+[^+]' | grep -qE "$GEN"; then
  echo "❌ pre-commit: 個人メール / 絶対パス(/Users/…) / 秘密ファイルの混入疑い"
  exit 1
fi
# worktree では --git-dir が .git/worktrees/<名前> を返し denylist が見つからず黙って飛ばされていた。
# worktree 間で共有される --git-common-dir を使う。
DL="$(git rev-parse --git-common-dir)/hooks/denylist.txt"
if [ -f "$DL" ] && git diff --cached --unified=0 "${SCAN[@]}" | grep -E '^\+[^+]' | grep -qiFf "$DL"; then
  echo "❌ pre-commit: denylist の識別子(漏洩済みidentifier/内部URL)が混入しています"
  exit 1
fi

# ─── (2) slug 衝突拒否（POLICIES §9） ───────────────────────────
# ステージされた data/municipalities/{slug}/kokuho-*.json を走査し、
# registry/index.json と citySlug+cityCode を照合。異なる cityCode で
# 同一 slug を入れようとした場合 commit を拒否。
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-slug-precommit.js; then
    exit 1
  fi
else
  echo "⚠️  pre-commit: node 不在のため slug 衝突チェックをスキップ"
fi

# ─── (3) cityCode 一次資料準拠（POLICIES §10） ──────────────────
# staged の cityCode を総務省一次資料スナップショットと照合。
# ERROR レベル（一次資料に存在しない / 値ズレ）は commit 拒否。
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-citycode-precommit.js; then
    exit 1
  fi
else
  echo "⚠️  pre-commit: node 不在のため cityCode 一次資料チェックをスキップ"
fi

# ─── (4) 数値表記の保全（civic-site-common-rules 中核ルール2） ───────
# staged の data/**/*.json と registry/index.json を HEAD と比べ、
# 値は同じなのに表記だけ変わった数値（0.0700→0.07 等）があれば commit 拒否。
# 意図した表記変更は ALLOW_NUMFMT=1 で通す（理由を commit message に書く）。
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-numeric-text.cjs; then
    exit 1
  fi
else
  echo "⚠️  pre-commit: node 不在のため数値表記チェックをスキップ"
fi

# ─── (5) 内部文書ガード ─────────────────────────────────────────
# ガード本体の場所は公開リポに書かず、VCS 外の git 設定から読む（install-hooks.sh が設定する）。
# 未設定・不在なら fail-closed。
GUARD="$(git config --get civic.guard || true)"
if [ -n "$GUARD" ] && [ -x "$GUARD" ]; then
  bash "$GUARD" --staged || exit 1
else
  echo "❌ pre-commit: 内部文書ガードが見つかりません（git config civic.guard='${GUARD}'）。fail-closed"
  echo "   bash scripts/install-hooks.sh を実行してください"
  exit 1
fi
