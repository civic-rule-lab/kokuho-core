#!/bin/bash
# ─────────────────────────────────────────────────────────────────
# kokuho-core pre-commit hook
#
# このファイルは tracked リポ内に置かれた**マスタ版**。
# .git/hooks/ は VCS 管理外なので、初回セットアップ時に
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
# でインストールが必要。
#
# 内容:
#   (1) credential / SUNNET / 個人 identity の混入禁止
#   (2) slug 衝突拒否（POLICIES §9）
# ─────────────────────────────────────────────────────────────────
set -e

# ─── (1) credential / SUNNET / 個人 identity の混入禁止 ──────────
# ⚠️ 公開リポにつき、具体識別子(個人メール/ユーザー名/内部ホスト等)は**この tracked ファイルに書かない**。
#    正本 GOVERNANCE.md §C-4。具体値は VCS外 denylist(.git/hooks/denylist.txt)から読む。
#    検知ルールを定義するインフラ(フック自身・CI)は走査対象から除外し自己誤爆を防ぐ。
SCAN=(-- . ':(exclude)scripts/git-hooks' ':(exclude).github')
GEN='@(gmail|yahoo|icloud|outlook|hotmail)\.com|/Users/[A-Za-z]|wrangler-account\.json|BEGIN (RSA|OPENSSH|PRIVATE)'
if git diff --cached --unified=0 "${SCAN[@]}" | grep -E '^\+[^+]' | grep -qE "$GEN"; then
  echo "❌ pre-commit: 個人メール / 絶対パス(/Users/…) / 秘密ファイルの混入疑い"
  exit 1
fi
DL="$(git rev-parse --git-dir)/hooks/denylist.txt"
if [ -f "$DL" ] && git diff --cached --unified=0 "${SCAN[@]}" | grep -E '^\+[^+]' | grep -qiFf "$DL"; then
  echo "❌ pre-commit: denylist の識別子(漏洩済みidentifier/内部URL)が混入しています"
  exit 1
fi

# ─── (2) slug 衝突拒否（POLICIES §9） ───────────────────────────
# ステージされた data/municipalities/{slug}/kokuho-*.json を走査し、
# registry/index.json と citySlug+cityCode を照合。異なる cityCode で
# 同一 slug を入れようとした場合 commit を拒否。
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-slug-precommit.js; then
    exit 1
  fi
else
  echo "⚠️  pre-commit: node 不在のため slug 衝突チェックをスキップ"
fi

# ─── (3) cityCode 一次資料準拠（POLICIES §10） ──────────────────
# staged の cityCode を総務省一次資料スナップショットと照合。
# ERROR レベル（一次資料に存在しない / 値ズレ）は commit 拒否。
if command -v node >/dev/null 2>&1; then
  if ! node scripts/check-citycode-precommit.js; then
    exit 1
  fi
else
  echo "⚠️  pre-commit: node 不在のため cityCode 一次資料チェックをスキップ"
fi
